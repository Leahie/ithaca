#!/bin/bash
#SBATCH -J ithaca_2dgs
#SBATCH -o /home/qx235/ithaca-recon/logs/%x_%j.out
#SBATCH -e /home/qx235/ithaca-recon/logs/%x_%j.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH --get-user-env
#SBATCH --mem=64g
#SBATCH -t 12:00:00
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
# One 2DGS training run (gsplat examples/simple_trainer_2dgs.py) on a COLMAP-format scan export.
# Usage: sbatch --constraint="a6000|6000ada|l40s" unicorn_train.sub <dataset dir name> <run name> [trainer args]
set -euo pipefail
ENV=/share/cuvl/qx235/envs/ithaca-recon
WORK=/share/cuvl/qx235/ithaca-recon
export PATH="$ENV/bin:$PATH" CUDA_HOME="$ENV" PYTHONUNBUFFERED=1
DATA="$WORK/data/$1"; RUN="$WORK/runs/$2"; shift 2
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
mkdir -p "$RUN"
cd "$WORK/gsplat/examples"
python simple_trainer_2dgs.py --data_dir "$DATA" --result_dir "$RUN" --disable_viewer "$@"
echo TRAIN_DONE
