{
  "$defs": {
    "NoiseScenario": {
      "properties": {
        "add_carpet": {
          "default": false,
          "title": "Add Carpet",
          "type": "boolean"
        },
        "glazing": {
          "anyOf": [
            {
              "enum": [
                "single",
                "double",
                "triple"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Glazing"
        },
        "include_furniture": {
          "default": true,
          "title": "Include Furniture",
          "type": "boolean"
        },
        "windows_open": {
          "default": false,
          "title": "Windows Open",
          "type": "boolean"
        }
      },
      "title": "NoiseScenario",
      "type": "object"
    },
    "Session": {
      "properties": {
        "client_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Token"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "pair_token": {
          "title": "Pair Token",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "pair_token",
        "expires_at"
      ],
      "title": "Session",
      "type": "object"
    },
    "SoundPlaceSourcePayload": {
      "description": "A sound placed in the house (C's sound_field computes what each room hears). Additive to v0.",
      "properties": {
        "level_dba": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level Dba"
        },
        "preset_id": {
          "title": "Preset Id",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "upload_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upload Id"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "room_id",
        "x",
        "z",
        "preset_id"
      ],
      "title": "SoundPlaceSourcePayload",
      "type": "object"
    },
    "SoundSetScenarioPayload": {
      "properties": {
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/NoiseScenario"
        }
      },
      "required": [
        "room_id",
        "scenario"
      ],
      "title": "SoundSetScenarioPayload",
      "type": "object"
    },
    "ViewerPlayback": {
      "properties": {
        "listening": {
          "default": false,
          "title": "Listening",
          "type": "boolean"
        },
        "playing": {
          "default": false,
          "title": "Playing",
          "type": "boolean"
        },
        "sounds": {
          "default": [
            "highway",
            "streets",
            "birds",
            "insects",
            "frogs"
          ],
          "items": {
            "enum": [
              "highway",
              "streets",
              "birds",
              "insects",
              "frogs",
              "dogs"
            ],
            "type": "string"
          },
          "title": "Sounds",
          "type": "array"
        },
        "voice": {
          "default": "female",
          "enum": [
            "female",
            "male"
          ],
          "title": "Voice",
          "type": "string"
        }
      },
      "title": "ViewerPlayback",
      "type": "object"
    },
    "ViewerState": {
      "description": "Payload of ``session.state``: what the desktop is showing. The hub keeps the latest copy\nand sends it on join (B9).",
      "properties": {
        "datetime": {
          "title": "Datetime",
          "type": "string"
        },
        "mode": {
          "enum": [
            "tour",
            "sun",
            "sound",
            "neighborhood",
            "design"
          ],
          "title": "Mode",
          "type": "string"
        },
        "playback": {
          "$ref": "#/$defs/ViewerPlayback",
          "default": {
            "listening": false,
            "playing": false,
            "sounds": [
              "highway",
              "streets",
              "birds",
              "insects",
              "frogs"
            ],
            "voice": "female"
          }
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "shown_layout_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shown Layout Ids",
          "type": "array"
        },
        "sound_scenario": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoundSetScenarioPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sound_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoundPlaceSourcePayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "datetime"
      ],
      "title": "ViewerState",
      "type": "object"
    }
  },
  "title": "session"
}
