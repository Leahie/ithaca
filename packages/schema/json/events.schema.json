{
  "$defs": {
    "AgentActionPayload": {
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "summary"
      ],
      "title": "AgentActionPayload",
      "type": "object"
    },
    "AgentErrorPayload": {
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "AgentErrorPayload",
      "type": "object"
    },
    "AgentMessagePayload": {
      "properties": {
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "text"
      ],
      "title": "AgentMessagePayload",
      "type": "object"
    },
    "AgentTokenPayload": {
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "string"
        },
        "message_id": {
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "delta"
      ],
      "title": "AgentTokenPayload",
      "type": "object"
    },
    "AgentTurnPayload": {
      "description": "Additive to v0. Brackets one agent turn, which may produce no agent.message at all.",
      "properties": {
        "status": {
          "enum": [
            "started",
            "ended"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "AgentTurnPayload",
      "type": "object"
    },
    "CaptureUploadPayload": {
      "properties": {
        "upload_id": {
          "title": "Upload Id",
          "type": "string"
        }
      },
      "required": [
        "upload_id"
      ],
      "title": "CaptureUploadPayload",
      "type": "object"
    },
    "CatalogPickedPayload": {
      "description": "Additive to v0. The user clicked a suggested piece; the app added and placed it.",
      "properties": {
        "catalog_id": {
          "title": "Catalog Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        }
      },
      "required": [
        "catalog_id",
        "item_id"
      ],
      "title": "CatalogPickedPayload",
      "type": "object"
    },
    "CatalogPiece": {
      "description": "A ready-made piece the user can add to their inventory without a photo.",
      "properties": {
        "catalog_id": {
          "title": "Catalog Id",
          "type": "string"
        },
        "dims_m": {
          "$ref": "#/$defs/ItemDims"
        },
        "item_class": {
          "title": "Item Class",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "thumbnail_url": {
          "title": "Thumbnail Url",
          "type": "string"
        }
      },
      "required": [
        "catalog_id",
        "label",
        "item_class",
        "dims_m",
        "thumbnail_url",
        "source"
      ],
      "title": "CatalogPiece",
      "type": "object"
    },
    "CatalogSuggestPayload": {
      "description": "Additive to v0. The agent shows catalog pieces as picture cards in the chat; the user adds\none by clicking it.",
      "properties": {
        "near_item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near Item Id"
        },
        "pieces": {
          "items": {
            "$ref": "#/$defs/CatalogPiece"
          },
          "title": "Pieces",
          "type": "array"
        },
        "property_id": {
          "title": "Property Id",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        }
      },
      "required": [
        "property_id",
        "pieces"
      ],
      "title": "CatalogSuggestPayload",
      "type": "object"
    },
    "ChatUserPayload": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ChatUserPayload",
      "type": "object"
    },
    "DesignShowVariantsPayload": {
      "properties": {
        "layout_ids": {
          "items": {
            "type": "string"
          },
          "title": "Layout Ids",
          "type": "array"
        }
      },
      "required": [
        "layout_ids"
      ],
      "title": "DesignShowVariantsPayload",
      "type": "object"
    },
    "EventEnvelope": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "member_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Member Id"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "desktop",
            "phone",
            "agent",
            "server"
          ],
          "title": "Source",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "v": {
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "ts",
        "session_id",
        "source",
        "type",
        "payload"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "FamilyAnswerPayload": {
      "description": "The asked agent's reply, from its own member's memory only (B4).",
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "ask_id": {
          "title": "Ask Id",
          "type": "string"
        },
        "from_member_id": {
          "title": "From Member Id",
          "type": "string"
        },
        "to_member_id": {
          "title": "To Member Id",
          "type": "string"
        }
      },
      "required": [
        "ask_id",
        "from_member_id",
        "to_member_id",
        "answer"
      ],
      "title": "FamilyAnswerPayload",
      "type": "object"
    },
    "FamilyAskPayload": {
      "description": "One member's agent asks another member's agent a question.",
      "properties": {
        "ask_id": {
          "title": "Ask Id",
          "type": "string"
        },
        "from_member_id": {
          "title": "From Member Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "to_member_id": {
          "title": "To Member Id",
          "type": "string"
        }
      },
      "required": [
        "ask_id",
        "from_member_id",
        "to_member_id",
        "question"
      ],
      "title": "FamilyAskPayload",
      "type": "object"
    },
    "FamilyNotePayload": {
      "description": "A note one member's agent posted to the family board, for the others to weigh.",
      "properties": {
        "member_id": {
          "title": "Member Id",
          "type": "string"
        },
        "note_id": {
          "title": "Note Id",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "member_id",
        "text"
      ],
      "title": "FamilyNotePayload",
      "type": "object"
    },
    "FurnitureDragPayload": {
      "description": "Additive to v0. A piece on its way across a plan editor, before it is saved: the 3D view\nmoves the piece with the finger. Interior frame; item_id None: the drag is over (the saved\npose, or the old one if the server refused, comes with the next furniture reload).",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "yaw_deg": {
          "default": 0.0,
          "title": "Yaw Deg",
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "FurnitureDragPayload",
      "type": "object"
    },
    "FurnitureOverviewPayload": {
      "description": "Additive to v0. Look down on a room from above while arranging it (None: back inside).",
      "properties": {
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        }
      },
      "title": "FurnitureOverviewPayload",
      "type": "object"
    },
    "FurnitureSelectPayload": {
      "description": "Additive to v0. The piece selected in a plan editor (None: nothing), so the 3D view can\npoint it out.",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        }
      },
      "title": "FurnitureSelectPayload",
      "type": "object"
    },
    "ItemDims": {
      "description": "Item space: w along X, d along Z, h along Y. Meters.",
      "properties": {
        "d": {
          "title": "D",
          "type": "number"
        },
        "h": {
          "title": "H",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        }
      },
      "required": [
        "w",
        "d",
        "h"
      ],
      "title": "ItemDims",
      "type": "object"
    },
    "JobProgressPayload": {
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "pct": {
          "title": "Pct",
          "type": "number"
        },
        "result_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Ref"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "kind",
        "pct",
        "status"
      ],
      "title": "JobProgressPayload",
      "type": "object"
    },
    "LayoutChangedPayload": {
      "description": "Additive to v0. The furniture changed: a client edited it by hand (moved, turned, added or\nremoved a piece), or the server applied a kept layout. Every screen in the session loads the\nhouse's furniture, the layouts and the inventory again.",
      "properties": {
        "layout_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Id"
        }
      },
      "title": "LayoutChangedPayload",
      "type": "object"
    },
    "LayoutConfirmPayload": {
      "description": "The user kept this layout: the server applies it to the house (F8).",
      "properties": {
        "layout_id": {
          "title": "Layout Id",
          "type": "string"
        }
      },
      "required": [
        "layout_id"
      ],
      "title": "LayoutConfirmPayload",
      "type": "object"
    },
    "LayoutSelectPayload": {
      "description": "The layout on screen. A proposal still `proposed` is previewed in its room; None ends the\npreview, so every room shows what is really in the house.",
      "properties": {
        "layout_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Id"
        }
      },
      "title": "LayoutSelectPayload",
      "type": "object"
    },
    "NoiseScenario": {
      "properties": {
        "add_carpet": {
          "default": false,
          "title": "Add Carpet",
          "type": "boolean"
        },
        "glazing": {
          "anyOf": [
            {
              "enum": [
                "single",
                "double",
                "triple"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Glazing"
        },
        "include_furniture": {
          "default": true,
          "title": "Include Furniture",
          "type": "boolean"
        },
        "windows_open": {
          "default": false,
          "title": "Windows Open",
          "type": "boolean"
        }
      },
      "title": "NoiseScenario",
      "type": "object"
    },
    "RemoteViewPayload": {
      "description": "Additive to v0. Which screen the phone remote is on, so the big screen can follow it\n(it shows the floor plan while the phone is choosing a room).",
      "properties": {
        "floor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Id"
        },
        "view": {
          "enum": [
            "move",
            "rooms",
            "guide",
            "furniture",
            "light"
          ],
          "title": "View",
          "type": "string"
        }
      },
      "required": [
        "view"
      ],
      "title": "RemoteViewPayload",
      "type": "object"
    },
    "SessionPresencePayload": {
      "properties": {
        "client": {
          "enum": [
            "desktop",
            "phone"
          ],
          "title": "Client",
          "type": "string"
        },
        "member_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Member Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "client"
      ],
      "title": "SessionPresencePayload",
      "type": "object"
    },
    "SoundClearSourcePayload": {
      "description": "Additive to v0. Removes the placed sound.",
      "properties": {},
      "title": "SoundClearSourcePayload",
      "type": "object"
    },
    "SoundPlaceSourcePayload": {
      "description": "A sound placed in the house (C's sound_field computes what each room hears). Additive to v0.",
      "properties": {
        "level_dba": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level Dba"
        },
        "preset_id": {
          "title": "Preset Id",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "upload_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upload Id"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "room_id",
        "x",
        "z",
        "preset_id"
      ],
      "title": "SoundPlaceSourcePayload",
      "type": "object"
    },
    "SoundSetScenarioPayload": {
      "properties": {
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/NoiseScenario"
        }
      },
      "required": [
        "room_id",
        "scenario"
      ],
      "title": "SoundSetScenarioPayload",
      "type": "object"
    },
    "Vec3": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vec3",
      "type": "object"
    },
    "ViewerGotoPayload": {
      "description": "Exactly one of room_id / sweep_id. With room_id, `at_sweep_id` and `look_at` (both additive\nto v0) say where to stand and what to face for the best view of the room.",
      "properties": {
        "at_sweep_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Sweep Id"
        },
        "look_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vec3"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "sweep_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep Id"
        }
      },
      "title": "ViewerGotoPayload",
      "type": "object"
    },
    "ViewerLookPayload": {
      "properties": {
        "pitch_delta_deg": {
          "title": "Pitch Delta Deg",
          "type": "number"
        },
        "yaw_delta_deg": {
          "title": "Yaw Delta Deg",
          "type": "number"
        }
      },
      "required": [
        "yaw_delta_deg",
        "pitch_delta_deg"
      ],
      "title": "ViewerLookPayload",
      "type": "object"
    },
    "ViewerPlayback": {
      "properties": {
        "listening": {
          "default": false,
          "title": "Listening",
          "type": "boolean"
        },
        "playing": {
          "default": false,
          "title": "Playing",
          "type": "boolean"
        },
        "sounds": {
          "default": [
            "highway",
            "streets",
            "birds",
            "insects",
            "frogs"
          ],
          "items": {
            "enum": [
              "highway",
              "streets",
              "birds",
              "insects",
              "frogs",
              "dogs"
            ],
            "type": "string"
          },
          "title": "Sounds",
          "type": "array"
        },
        "voice": {
          "default": "female",
          "enum": [
            "female",
            "male"
          ],
          "title": "Voice",
          "type": "string"
        }
      },
      "title": "ViewerPlayback",
      "type": "object"
    },
    "ViewerPlaybackPayload": {
      "description": "Additive to v0. What the big screen is playing: the day passing, the outside sounds (and\nwhich of them), and the guide's voice. Each field is optional; one event changes only the\nfields it names. The desktop runs the clock while ``playing``, so a phone and a desktop never\nboth advance time.",
      "properties": {
        "listening": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listening"
        },
        "playing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playing"
        },
        "sounds": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "highway",
                  "streets",
                  "birds",
                  "insects",
                  "frogs",
                  "dogs"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sounds"
        },
        "voice": {
          "anyOf": [
            {
              "enum": [
                "female",
                "male"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice"
        }
      },
      "title": "ViewerPlaybackPayload",
      "type": "object"
    },
    "ViewerSetModePayload": {
      "properties": {
        "mode": {
          "enum": [
            "tour",
            "sun",
            "sound",
            "neighborhood",
            "design"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "ViewerSetModePayload",
      "type": "object"
    },
    "ViewerSetTimePayload": {
      "properties": {
        "datetime": {
          "title": "Datetime",
          "type": "string"
        }
      },
      "required": [
        "datetime"
      ],
      "title": "ViewerSetTimePayload",
      "type": "object"
    },
    "ViewerState": {
      "description": "Payload of ``session.state``: what the desktop is showing. The hub keeps the latest copy\nand sends it on join (B9).",
      "properties": {
        "datetime": {
          "title": "Datetime",
          "type": "string"
        },
        "mode": {
          "enum": [
            "tour",
            "sun",
            "sound",
            "neighborhood",
            "design"
          ],
          "title": "Mode",
          "type": "string"
        },
        "playback": {
          "$ref": "#/$defs/ViewerPlayback",
          "default": {
            "listening": false,
            "playing": false,
            "sounds": [
              "highway",
              "streets",
              "birds",
              "insects",
              "frogs"
            ],
            "voice": "female"
          }
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "shown_layout_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shown Layout Ids",
          "type": "array"
        },
        "sound_scenario": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoundSetScenarioPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sound_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoundPlaceSourcePayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "datetime"
      ],
      "title": "ViewerState",
      "type": "object"
    },
    "ViewerStepPayload": {
      "description": "Additive to v0. The phone's arrows: one hop to the next scan position ahead of, or behind,\nthe way the camera faces. Turning is a `viewer.look`. `angle_deg` (the phone's joystick) is the\nway to go, clockwise from straight ahead: 0 forward, 90 right, 180 back; it wins over\n`direction`.",
      "properties": {
        "angle_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Deg"
        },
        "direction": {
          "default": "forward",
          "enum": [
            "forward",
            "back"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "title": "ViewerStepPayload",
      "type": "object"
    },
    "ViewerWalkPayload": {
      "description": "Additive to v0. Walk the camera from one room to another, sweep by sweep.",
      "properties": {
        "distance_m": {
          "title": "Distance M",
          "type": "number"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "from_room_id": {
          "title": "From Room Id",
          "type": "string"
        },
        "look_at": {
          "$ref": "#/$defs/Vec3"
        },
        "sweep_ids": {
          "items": {
            "type": "string"
          },
          "title": "Sweep Ids",
          "type": "array"
        },
        "to_room_id": {
          "title": "To Room Id",
          "type": "string"
        }
      },
      "required": [
        "from_room_id",
        "to_room_id",
        "sweep_ids",
        "look_at",
        "distance_m",
        "duration_s"
      ],
      "title": "ViewerWalkPayload",
      "type": "object"
    },
    "ViewerZoomPayload": {
      "description": "Additive to v0. The phone's pinch: a change in zoom, positive in, negative out (1.0 = one\nwhole zoom level).",
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "number"
        }
      },
      "required": [
        "delta"
      ],
      "title": "ViewerZoomPayload",
      "type": "object"
    },
    "VoiceTranscriptPayload": {
      "properties": {
        "final": {
          "title": "Final",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "final"
      ],
      "title": "VoiceTranscriptPayload",
      "type": "object"
    }
  },
