{
  "$defs": {
    "AgentAction": {
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "summary"
      ],
      "title": "AgentAction",
      "type": "object"
    },
    "AgentError": {
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "AgentMessage": {
      "properties": {
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "text"
      ],
      "title": "AgentMessage",
      "type": "object"
    },
    "AgentToken": {
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "string"
        },
        "message_id": {
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "delta"
      ],
      "title": "AgentToken",
      "type": "object"
    },
    "AgentTurn": {
      "description": "Additive to v0. Brackets one agent turn, which may produce no agent.message at all.",
      "properties": {
        "status": {
          "enum": [
            "started",
            "ended"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "AgentTurn",
      "type": "object"
    },
    "CaptureUpload": {
      "properties": {
        "upload_id": {
          "title": "Upload Id",
          "type": "string"
        }
      },
      "required": [
        "upload_id"
      ],
      "title": "CaptureUpload",
      "type": "object"
    },
    "ChatUser": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ChatUser",
      "type": "object"
    },
    "DesignShowVariants": {
      "properties": {
        "layout_ids": {
          "items": {
            "type": "string"
          },
          "title": "Layout Ids",
          "type": "array"
        }
      },
      "required": [
        "layout_ids"
      ],
      "title": "DesignShowVariants",
      "type": "object"
    },
    "Envelope": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "desktop",
            "phone",
            "agent",
            "server"
          ],
          "title": "Source",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "v": {
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "source",
        "type"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "JobProgress": {
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "pct": {
          "title": "Pct",
          "type": "number"
        },
        "result_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Ref"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "kind",
        "pct",
        "status"
      ],
      "title": "JobProgress",
      "type": "object"
    },
    "LayoutSelect": {
      "properties": {
        "layout_id": {
          "title": "Layout Id",
          "type": "string"
        }
      },
      "required": [
        "layout_id"
      ],
      "title": "LayoutSelect",
      "type": "object"
    },
    "SessionPresence": {
      "properties": {
        "client": {
          "enum": [
            "desktop",
            "phone"
          ],
          "title": "Client",
          "type": "string"
        }
      },
      "required": [
        "client"
      ],
      "title": "SessionPresence",
      "type": "object"
    },
    "SoundSetScenario": {
      "properties": {
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "scenario": {
          "additionalProperties": true,
          "title": "Scenario",
          "type": "object"
        }
      },
      "required": [
        "room_id",
        "scenario"
      ],
      "title": "SoundSetScenario",
      "type": "object"
    },
    "ViewerGoto": {
      "properties": {
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "sweep_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep Id"
        }
      },
      "title": "ViewerGoto",
      "type": "object"
    },
    "ViewerLook": {
      "properties": {
        "pitch_delta_deg": {
          "title": "Pitch Delta Deg",
          "type": "number"
        },
        "yaw_delta_deg": {
          "title": "Yaw Delta Deg",
          "type": "number"
        }
      },
      "required": [
        "yaw_delta_deg",
        "pitch_delta_deg"
      ],
      "title": "ViewerLook",
      "type": "object"
    },
    "ViewerSetMode": {
      "properties": {
        "mode": {
          "enum": [
            "tour",
            "sun",
            "sound",
            "neighborhood",
            "design"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "ViewerSetMode",
      "type": "object"
    },
    "ViewerSetTime": {
      "properties": {
        "datetime": {
          "title": "Datetime",
          "type": "string"
        }
      },
      "required": [
        "datetime"
      ],
      "title": "ViewerSetTime",
      "type": "object"
    },
    "ViewerState": {
      "description": "What the desktop is showing. The hub keeps the latest copy and sends it on join (B9).",
      "properties": {
        "datetime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datetime"
        },
        "mode": {
          "default": "tour",
          "enum": [
            "tour",
            "sun",
            "sound",
            "neighborhood",
            "design"
          ],
          "title": "Mode",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "shown_layout_ids": {
          "items": {
            "type": "string"
          },
          "title": "Shown Layout Ids",
          "type": "array"
        },
        "sound_scenario": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sound Scenario"
        }
      },
      "title": "ViewerState",
      "type": "object"
    },
    "VoiceTranscript": {
      "properties": {
        "final": {
          "title": "Final",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "final"
      ],
      "title": "VoiceTranscript",
      "type": "object"
    }
  },
  "title": "events",
  "x-event-types": {
    "agent.action": {
      "payload": "AgentAction",
      "sent_by": [
        "agent"
      ]
    },
    "agent.error": {
      "payload": "AgentError",
      "sent_by": [
        "agent"
      ]
    },
    "agent.message": {
      "payload": "AgentMessage",
      "sent_by": [
        "agent"
      ]
    },
    "agent.token": {
      "payload": "AgentToken",
      "sent_by": [
        "agent"
      ]
    },
    "agent.turn": {
      "payload": "AgentTurn",
      "sent_by": [
        "agent"
      ]
    },
    "capture.upload": {
      "payload": "CaptureUpload",
      "sent_by": [
        "desktop",
        "phone"
      ]
    },
    "chat.user": {
      "payload": "ChatUser",
      "sent_by": [
        "desktop",
        "phone"
      ]
    },
    "design.showVariants": {
      "payload": "DesignShowVariants",
      "sent_by": [
        "agent"
      ]
    },
    "job.progress": {
      "payload": "JobProgress",
      "sent_by": [
        "server"
      ]
    },
    "layout.select": {
      "payload": "LayoutSelect",
      "sent_by": [
        "desktop",
        "phone"
      ]
    },
    "session.joined": {
      "payload": "SessionPresence",
      "sent_by": [
        "server"
      ]
    },
    "session.left": {
      "payload": "SessionPresence",
      "sent_by": [
        "server"
      ]
    },
    "session.state": {
      "payload": "ViewerState",
      "sent_by": [
        "server"
      ]
    },
    "sound.setScenario": {
      "payload": "SoundSetScenario",
      "sent_by": [
        "agent",
        "desktop",
        "phone"
      ]
    },
    "viewer.goto": {
      "payload": "ViewerGoto",
      "sent_by": [
        "agent",
        "desktop",
        "phone"
      ]
    },
    "viewer.look": {
      "payload": "ViewerLook",
      "sent_by": [
        "phone"
      ]
    },
    "viewer.setMode": {
      "payload": "ViewerSetMode",
      "sent_by": [
        "agent",
        "desktop",
        "phone"
      ]
    },
    "viewer.setTime": {
      "payload": "ViewerSetTime",
      "sent_by": [
        "agent",
        "desktop",
        "phone"
      ]
    },
    "voice.transcript": {
      "payload": "VoiceTranscript",
      "sent_by": [
        "desktop",
        "phone"
      ]
    }
  }
}
