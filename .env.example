# Copy to .env (backend) and apps/web/.env.local (frontend). Never commit real keys.
# Shared file: each stream adds its own keys (WORKSTREAMS.md 1.1).

# --- Stream C: Twin, Data & Simulation (backend only) ------------------------------------
# From /costar-keys in the track Discord. Basic auth: key = username, token = password.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Sent as the X-API-KEY header.
VEXCEL_API_KEY=

# live | record | replay (CI uses replay)
INTEGRATION_MODE=record
# fixture | live
TWIN_MODE=fixture
COSTAR_KIT_DIR=data/costar-hackathon-kit

# Data services from compose.yaml (docker compose up -d init). These are the values for code
# running on the host; inside compose the hosts are postgres, redis and s3.
DATABASE_URL=postgresql+psycopg://ithaca:ithaca@localhost:5432/ithaca
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
# Base URL the browser uses for stored objects.
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=ithaca
S3_SECRET_KEY=ithaca-dev-secret
S3_BUCKET=ithaca

# --- Stream A: web (apps/web/.env.local) -------------------------------------------------
# A6: run every tab from the fixtures folder, with no backend and a scripted agent.
NEXT_PUBLIC_USE_FIXTURES=1
# Matterport Showcase SDK key. The only secret the frontend holds (I-G22). Empty = Tour tab off.
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
# What the house page shows: tour, sun (both default), sound, neighborhood, design, agent, phone, me, or all.
NEXT_PUBLIC_FEATURES=tour,sun,hands
# embed (default): Matterport's hosted viewer, with the outside view. bundle: can place furniture
# in the tour, but has no outside view.
NEXT_PUBLIC_MATTERPORT_VIEWER=embed
# 1 = let the bundled Matterport viewer load exterior splat captures. Leave unset: bundle 26.5.4
# hangs on them (apps/web/src/lib/showcase/splatShim.ts).
NEXT_PUBLIC_MATTERPORT_SPLATS=
# Property opened at "/". Empty = a form asks for an id (I-G19: no property id in code).
NEXT_PUBLIC_DEFAULT_PROPERTY_ID=onXQLXhfyQv
# v1 has one user, sent as X-User-Id (I-G18).
NEXT_PUBLIC_USER_ID=demo
# REST base. Default "/api" is proxied by Next to API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE=/api
API_PROXY_TARGET=http://localhost:8000
# WebSocket origin of the session hub. Empty = the page's own origin (Next proxies /ws to the API).
NEXT_PUBLIC_WS_BASE=
# Origin a phone can reach, for the pairing QR code, e.g. https://192.168.1.20:3000
NEXT_PUBLIC_PUBLIC_ORIGIN=
# Hosts allowed to load the dev server (the phone's view of your machine), comma-separated.
DEV_ALLOWED_ORIGINS=
# Speech provider behind the SpeechProvider interface. webspeech: the browser's own voice and
# speech recognition. deepgram: Deepgram's voices and transcription through the API (needs
# DEEPGRAM_API_KEY there; falls back to the browser).
NEXT_PUBLIC_SPEECH_PROVIDER=webspeech

# --- Stream B: Agent (backend only) --------------------------------------------------------
# deep | scripted. Unset = deep if an LLM key is set, else scripted (fake agent, no LLM).
AGENT_PROVIDER=
# 0 turns off the background tour observer (it makes extra LLM calls). AGENT_MODEL_OBSERVER picks its model.
AGENT_OBSERVER=1
# 1 lets family members' agents reach each other (family board, asking another member's agent). Off: each agent knows only its own person.
FAMILY_AGENTS_TALK=0
# anthropic | openrouter
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional for anthropic (default claude-sonnet-5-5). Required for openrouter: a model id that
# supports tool calling. AGENT_MODEL_<ROLE> overrides it for one role (e.g. AGENT_MODEL_DESIGNER).
AGENT_MODEL=

# The guide's voice (POST /api/speech/tts) and push-to-talk transcription (WS /ws/speech/listen).
# Empty = the browser's own speech. Key from https://console.deepgram.com.
# The big screen switches between a woman's and a man's voice: DEEPGRAM_TTS_MODEL and
# DEEPGRAM_TTS_MODEL_MALE (default aura-2-thalia-en, aura-2-orion-en). DEEPGRAM_STT_MODEL and
# DEEPGRAM_STT_LANGUAGE pick the transcription (default nova-3, en).
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=
DEEPGRAM_TTS_MODEL_MALE=
DEEPGRAM_STT_MODEL=
DEEPGRAM_STT_LANGUAGE=

# Photo -> furniture pipeline. fal | catalog | stub. Unset = fal if FAL_KEY is set, else catalog
# (free ready-made models from Poly Haven, sized to the photo's dimensions). stub = plain boxes. FAL_KEY from https://fal.ai/dashboard/keys
OBJECT_PROVIDER=
FAL_KEY=
# 3D model on fal. sam3d (default, about $0.02 a piece: sees the whole photo, fills in hidden
# parts, estimates the real size) | trellis (about $0.30: needs a fully visible piece).
OBJECT_3D_MODEL=
# How a piece is cut out of a photo. fal | local | whole. Unset = fal when OBJECT_PROVIDER is fal,
# else whole (no cutting). local runs Grounding DINO + SAM 2 on this machine, no key needed:
# scripts/dev.sh then also installs services/api/objects/requirements-segment.txt.
OBJECT_SEGMENTER=
