# Copy to .env and fill in. Never commit .env.

# Stream C: Twin, Data & Simulation (backend only)
# From /costar-keys in the track Discord. Basic auth: key = username, token = password.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Sent as the X-API-KEY header.
VEXCEL_API_KEY=

# live | record | replay (CI uses replay)
INTEGRATION_MODE=record
# fixture | live
TWIN_MODE=fixture
COSTAR_KIT_DIR=data/costar-hackathon-kit

# Stream A (frontend only; the Showcase SDK key is safe in the browser)
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
