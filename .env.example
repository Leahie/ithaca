# Copy to .env (backend) and apps/web/.env.local (frontend). Never commit real keys.
# Shared file: each stream adds its own keys (WORKSTREAMS.md 1.1).

# --- Stream C: Twin, Data & Simulation (backend only) ------------------------------------
# From /costar-keys in the track Discord. Basic auth: key = username, token = password.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Sent as the X-API-KEY header.
VEXCEL_API_KEY=

# live | record | replay (CI uses replay)
INTEGRATION_MODE=record
# fixture | live
TWIN_MODE=fixture
COSTAR_KIT_DIR=data/costar-hackathon-kit

# --- Stream A: web (apps/web/.env.local) -------------------------------------------------
# A6: run every tab from the fixtures folder, with no backend and a scripted agent.
NEXT_PUBLIC_USE_FIXTURES=1
# Matterport Showcase SDK key. The only secret the frontend holds (I-G22). Empty = Tour tab off.
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
# What the house page shows: tour (default), sun, sound, neighborhood, design, agent, phone, me, or all.
NEXT_PUBLIC_FEATURES=tour
# embed (default): Matterport's hosted viewer, with the outside view. bundle: can place furniture
# in the tour, but has no outside view.
NEXT_PUBLIC_MATTERPORT_VIEWER=embed
# 1 = let the bundled Matterport viewer load exterior splat captures. Leave unset: bundle 26.5.4
# hangs on them (apps/web/src/lib/showcase/splatShim.ts).
NEXT_PUBLIC_MATTERPORT_SPLATS=
# Property opened at "/". Empty = a form asks for an id (I-G19: no property id in code).
NEXT_PUBLIC_DEFAULT_PROPERTY_ID=onXQLXhfyQv
# v1 has one user, sent as X-User-Id (I-G18).
NEXT_PUBLIC_USER_ID=demo
# REST base. Default "/api" is proxied by Next to API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE=/api
API_PROXY_TARGET=http://localhost:8000
# WebSocket origin of the session hub. Empty = same host as the page, port 8000.
NEXT_PUBLIC_WS_BASE=
# Origin a phone can reach, for the pairing QR code, e.g. https://192.168.1.20:3000
NEXT_PUBLIC_PUBLIC_ORIGIN=
# Hosts allowed to load the dev server (the phone's view of your machine), comma-separated.
DEV_ALLOWED_ORIGINS=
# Speech provider behind the SpeechProvider interface. Only "webspeech" exists today.
NEXT_PUBLIC_SPEECH_PROVIDER=webspeech

# --- Stream B: Agent (backend only) --------------------------------------------------------
# deep | scripted. Unset = deep if an LLM key is set, else scripted (fake agent, no LLM).
AGENT_PROVIDER=
# 0 turns off the background tour observer (it makes extra LLM calls). AGENT_MODEL_OBSERVER picks its model.
AGENT_OBSERVER=1
# anthropic | openrouter
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional for anthropic (default claude-sonnet-5-5). Required for openrouter: a model id that
# supports tool calling. AGENT_MODEL_<ROLE> overrides it for one role (e.g. AGENT_MODEL_DESIGNER).
AGENT_MODEL=
