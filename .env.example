# Copy to .env and fill in. Never commit .env.

# Stream C: Twin, Data & Simulation (backend only)
# From /costar-keys in the track Discord. Basic auth: key = username, token = password.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Sent as the X-API-KEY header.
VEXCEL_API_KEY=

# live | record | replay (CI uses replay)
INTEGRATION_MODE=record
# fixture | live
TWIN_MODE=fixture
COSTAR_KIT_DIR=data/costar-hackathon-kit

# Stream A (frontend only; the Showcase SDK key is safe in the browser)
NEXT_PUBLIC_MATTERPORT_SDK_KEY=

# Stream B: Agent (backend only)
# deep | scripted. Unset = deep if an LLM key is set, else scripted (fake agent, no LLM).
AGENT_PROVIDER=
# 0 turns off the background tour observer (it makes extra LLM calls). AGENT_MODEL_OBSERVER picks its model.
AGENT_OBSERVER=1
# anthropic | openrouter
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional for anthropic (default claude-sonnet-5-5). Required for openrouter: a model id that
# supports tool calling. AGENT_MODEL_<ROLE> overrides it for one role (e.g. AGENT_MODEL_DESIGNER).
AGENT_MODEL=
